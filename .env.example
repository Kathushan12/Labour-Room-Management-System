# Local Development Environment Template
POSTGRES_DB=lrms_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_PORT=5433

DATABASE_URL=postgresql://postgres@localhost:5433/lrms_dev

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# 32-byte (64 hex characters) AES-256-GCM data encryption key
LRMS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# HMAC-SHA256 blind indexing secret key (strictly distinct from AES encryption key, min 32 bytes)
LRMS_HMAC_KEY=lrms_dev_hmac_secret_key_minimum_32_characters_long_for_security

# Phase 4 Authentication & JWT Configuration
JWT_ACCESS_EXPIRATION_SECONDS=900
# Session lifetime (REQ-1.5): idle timeout and absolute limit from login
SESSION_IDLE_TIMEOUT_MINUTES=60
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Failed logins allowed per IP per 15 min (default 100 in dev, 20 in production)
# LOGIN_IP_MAX_FAILED_ATTEMPTS=100
TEMP_PASSWORD_EXPIRATION_HOURS=24
JWT_ISSUER=lrms-api
JWT_AUDIENCE=lrms-web
# Optional inline PEM keys; if unset in development, 2048-bit RSA keys are auto-generated to .keys/
# JWT_PRIVATE_KEY=""
# JWT_PUBLIC_KEY=""
CSRF_SECRET=lrms_csrf_secret_key_minimum_32_characters_for_protection
COOKIE_SECURE=false

VITE_API_BASE_URL=http://localhost:4000/api/v1
